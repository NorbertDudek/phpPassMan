# Hosting-specific PHP version selection, e.g. (uncomment and adjust if your host needs it):
# AddHandler application/x-httpd-php74 php


# Blokada bezpośredniego dostępu do konfiguracji (także kopii typu config.php.bak, config.php~)
<FilesMatch "^config\.php(\..*|~)?$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

